{
  "version": 1,
  "bot": {
    "name": "DisRunner Lifecycle Fixture Bot",
    "runtime": "node",
    "startCommand": "node server.mjs",
    "entryPoint": "server.mjs",
    "workingDirectory": "."
  },
  "adapter": {
    "type": "raw-interaction-webhook",
    "interactionEndpoint": "http://127.0.0.1:${DISRUNNER_BOT_PORT}/interactions",
    "restBaseUrl": "http://127.0.0.1:${DISRUNNER_REST_PORT}/api/v10",
    "gatewayUrl": "ws://127.0.0.1:${DISRUNNER_GATEWAY_PORT}"
  },
  "environment": {
    "DISRUNNER_OFFLINE": "1"
  },
  "profile": {
    "mode": "strict",
    "seed": 42042,
    "intents": ["GUILDS"],
    "networkPolicy": "offline",
    "hotReload": false
  },
  "fixtures": {
    "guild": "guild.json",
    "user": "user.json"
  }
}
