{
  "name": "disrunner",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic offline Discord bot simulator for local development and CI.",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "11.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @disrunner/desktop dev",
    "dev:web": "pnpm --filter @disrunner/desktop dev:web",
    "build": "pnpm -r --if-present run build",
    "build:core": "pnpm --filter @disrunner/core build",
    "build:desktop": "pnpm run build:runtime && pnpm --filter @disrunner/desktop build",
    "build:cli": "pnpm run build:runtime && pnpm --filter @disrunner/cli build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node .github/scripts/check-versions.mjs",
    "lint": "pnpm run build:runtime && eslint . --max-warnings=0",
    "typecheck": "pnpm run build:runtime && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:unit": "pnpm --filter @disrunner/core test:unit",
    "test:contract": "pnpm --filter @disrunner/core test:contract",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:offline": "pnpm --filter @disrunner/core test:offline",
    "test:security": "pnpm --filter @disrunner/core test:security",
    "test:desktop": "pnpm --filter @disrunner/desktop test",
    "test:raw-webhook": "pnpm --filter @disrunner/example-raw-webhook-bot test",
    "test:secret-scanner": "node .github/scripts/scan-secrets.test.mjs",
    "test:linux-sandbox": "node --test .github/scripts/prepare-linux-sandbox.test.mjs apps/desktop/tests/e2e/linux-sandbox.test.mjs",
    "test:e2e": "pnpm --filter @disrunner/desktop test:e2e",
    "test:perf": "pnpm --filter @disrunner/core test:perf",
    "verify": "pnpm run check:versions && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:contract && pnpm run test:integration && pnpm run test:offline && pnpm run test:security && pnpm run test:desktop && pnpm run test:raw-webhook && pnpm run test:secret-scanner && pnpm run test:linux-sandbox && pnpm run build",
    "verify:release": "pnpm run verify && pnpm run test:e2e && pnpm run test:perf",
    "cli": "pnpm --filter @disrunner/cli start",
    "clean": "node scripts/clean.mjs",
    "build:runtime": "pnpm run build:core && pnpm --filter @disrunner/runtime build",
    "test:runtime": "pnpm run build:runtime && pnpm --filter @disrunner/runtime test",
    "test:conformance": "pnpm run build:runtime && node --test --test-concurrency=1 tests/conformance/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.2"
  }
}
