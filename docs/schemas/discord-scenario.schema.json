            },
            "at": {
              "type": "number",
              "minimum": 0
            },
            "resumable": {
              "type": "boolean"
            }
          },
          "required": ["at"],
          "oneOf": [
            {
              "required": ["type"]
            },
            {
              "required": ["action"]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "gateway-resume"
            },
            "action": {
              "const": "gateway-resume"
            },
            "at": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["at"],
          "oneOf": [
            {
              "required": ["type"]
            },
            {
              "required": ["action"]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "timeline-gateway-resume"
            },
            "action": {
              "const": "timeline-gateway-resume"
            },
            "at": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["at"],
          "oneOf": [
            {
              "required": ["type"]
            },
            {
              "required": ["action"]
            }
          ]
        }
      ]
    }
  }
}
