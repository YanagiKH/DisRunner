{
  "name": "@disrunner/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "YanagiKH",
  "description": "Secure Electron desktop shell for the DisRunner offline Discord bot simulator.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm --filter @disrunner/core run build && pnpm run electron:compile && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "build": "pnpm run typecheck && vite build && pnpm run electron:compile",
    "package": "pnpm --filter @disrunner/core run build && pnpm run build && electron-builder",
    "test:package-smoke": "node tests/e2e/package-smoke.mjs",
    "package-and-smoke": "pnpm run package --publish never && pnpm run test:package-smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run && pnpm run test:runtime-manager",
    "test:runtime-manager": "node --no-warnings=ExperimentalWarning --experimental-loader ./tests/runtime/typescript-loader.mjs --test tests/runtime/interaction-peer-auth.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@disrunner/core": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.disrunner.desktop",
    "productName": "DisRunner",
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "../../docs/assets/disrunner-logo.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "../../docs/assets/disrunner-logo.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "../../docs/assets/disrunner-logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "publish": null
  }
}
